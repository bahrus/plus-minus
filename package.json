{
  "name": "plus-minus",
  "version": "0.0.14",
  "keywords": [
    "web-components",
    "web-component",
    "custom-element",
    "custom-elements",
    "expandable-button"
  ],
  "type": "module",
  "description": "Expandable/collapsible button",
  "main": "base.js",
  "module": "base.js",
  "exports": {
    ".": "./base.js",
    "./base.js": "./base.js"
  },
  "types": "./types.d.ts",
  "files": [
    "*.*",
    "./ts-refs/wc-info/**/*"
  ],
  "scripts": {
    "test": "playwright test",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "build-manifest": "node doc.mjs > custom-elements.json",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install",
    "watch": "npm-watch",
    "build-html": "powershell -command \"node build.mjs | out-file  -encoding  oem root.html\"",
    "build": "npm run build-html & npm run build-manifest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/plus-minus.git"
  },
  "dependencies": {
    "imp-h": "0.0.2",
    "trans-render": "0.0.960",
    "xtal-element": "0.0.636"
  },
  "devDependencies": {
    "wc-info": "0.0.185",
    "spa-ssi": "0.0.23",
    "@playwright/test": "1.56.1"
  },
  "author": "anderson.bruce.b@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/plus-minus/issues"
  },
  "homepage": "https://github.com/bahrus/plus-minus#readme"
}
